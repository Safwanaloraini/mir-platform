# ===== متغيرات البيئة للاستضافة =====
# بدّل القيم قبل النشر

# الرابط العام للموقع (بدون شرطة مائلة في الآخر)
PUBLIC_URL=https://mir.yourdomain.com

# مفتاح تشفير الجلسات — اجعله طويلاً ومعقدًا (32 حرفًا على الأقل)
# يمكنك توليده عبر: openssl rand -hex 32
MIR_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars
